      "Bash(~/bin/rei-mac cevap-ayar *)",
      "Bash(/home/rei/bin/rei-mac cevap-ayar *)",
      "Bash(*rei-mac cevap-ayar *)",
      "mcp__claude_ai_Google_Calendar__*create*",
      "mcp__claude_ai_Google_Calendar__*update*",
