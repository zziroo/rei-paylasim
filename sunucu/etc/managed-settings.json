{
  "allowManagedHooksOnly": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REI_KANCASIZ\" ] || node \"$HOME/.claude/hooks/oturum-baslangici.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REI_KANCASIZ\" ] || node \"$HOME/.claude/hooks/baglam-uyarisi.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REI_KANCASIZ\" ] || node \"$HOME/.claude/hooks/ajan-tavani.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REI_KANCASIZ\" ] || /usr/bin/node /usr/local/lib/rei/rei-adim",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REI_KANCASIZ\" ] || /usr/bin/node /usr/local/lib/rei/rei-adim",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.claude/channels/telegram/.env)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/channels/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/telegram-eklenti/**)",
      "Edit(~/bin/**)",
      "Edit(~/ZZ/claude-kurulum/**)",
      "Edit(~/ZZ/.claude/**)",
      "Read(//etc/x-ui/**)",
      "Edit(//etc/**)",
      "mcp__claude_ai_Gmail__*send*",
      "mcp__claude_ai_Gmail__*reply*",
      "mcp__claude_ai_Gmail__*forward*",
      "mcp__claude_ai_Gmail__*delete*",
      "mcp__claude_ai_Gmail__*trash*",
      "mcp__claude_ai_Gmail__*Send*",
      "mcp__claude_ai_Gmail__*Reply*",
      "mcp__claude_ai_Gmail__*Forward*",
      "mcp__claude_ai_Gmail__*Delete*",
      "mcp__claude_ai_Gmail__*Trash*",
      "mcp__claude_ai_Gmail__apply_sensitive_*",
      "mcp__claude_ai_Gmail__*spam*",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__*share*",
      "mcp__claude_ai_Google_Drive__*Share*",
      "mcp__claude_ai_Google_Drive__*trash*",
      "mcp__claude_ai_Google_Drive__*Trash*",
      "mcp__claude_ai_Google_Drive__*delete*",
      "mcp__claude_ai_Google_Drive__*Delete*"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(rei-vps ziroobank-api POST /mail/resend *)",
