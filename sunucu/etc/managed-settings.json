      "Bash(/home/rei/bin/rei-vps diskort-incelendi *)",
      "Bash(*rei-vps diskort-incelendi *)",
      "Bash(*ziroobank-api DELETE *)",
      "Bash(*ziroobank-api POST /entries*)",
      "Bash(*ziroobank-api PUT /entries*)",
      "Bash(*ziroobank-api PUT /months/*false*)",
      "Bash(rei-mac is *)",
      "Bash(~/bin/rei-mac is *)",
      "Bash(/home/rei/bin/rei-mac is *)",
      "Bash(*rei-mac is *)",
      "Bash(rei-mac birlestir *)",
      "Bash(~/bin/rei-mac birlestir *)",
      "Bash(/home/rei/bin/rei-mac birlestir *)",
      "Bash(*rei-mac birlestir *)",
      "Bash(rei-mac bitir *)",
      "Bash(~/bin/rei-mac bitir *)",
      "Bash(/home/rei/bin/rei-mac bitir *)",
      "Bash(*rei-mac bitir *)",
