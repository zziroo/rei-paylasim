# /etc/rei/rei.env (root, 600): rei.service'in ortam değişkenleri. Bot token'ı BURAYA DEĞİL,
# ~/.claude/channels/telegram/.env dosyasına (claude içinde /telegram:configure ile) yazılır.
# Eşleştirme bittikten sonra allowlist'i dondurmak için:
TELEGRAM_ACCESS_MODE=static
# Claude CLI kendiliğinden güncellenmesin: 05:00 restart'ında kanal davranışı sessizce değişebilir (kanallar önizleme). Güncelleme Yusuf onayıyla, elle.
DISABLE_AUTOUPDATER=1
