[Unit]
Description=Rei: 30 günden eski mesaj dosyalarını siler

[Service]
Type=oneshot
User=reisms
Group=reisms
ExecStart=/usr/bin/find /var/lib/rei-sms -maxdepth 1 -type f -name '*.jsonl' -mtime +29 -delete
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/rei-sms
