#!/usr/bin/env bash
# Ana VPS'te Rei'nin salt okunur deploy durumu kapısı. root olarak çalışır; `deploy` kullanıcısı yalnız /etc/sudoers.d/rei-deploy ile
# ve yalnız rei-kapi üzerinden çağırır. Kaynak: rei projesi sunucu/vps/rei-deploy (root:root 755).
# Deploy ve geri alma burada yok (2026-11-02): Claude oturumlarından, her projenin kendi yordamıyla yapılır.
#
# Kullanım:
#   rei-deploy durum <proje>   fetch + bekleyen commit'ler, konteyner ve sağlık durumu (git fetch dışında salt okunur)
#   rei-deploy log   <proje>   Rei kapısının son deploy günlüğünün kuyruğu (bu kapı artık yeni günlük yazmaz)
# Projeler: diskort (VPS'teki git klonu /opt/diskort, dal main).
# Günlükler: /var/log/rei-deploy/<proje>-<zaman>.log (root 600).
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOGDIR=/var/log/rei-deploy

[ "$#" -eq 2 ] || { echo "kullanım: rei-deploy durum|log <proje>" >&2; exit 1; }
islem="$1"; proje="$2"

case "$proje" in
  diskort)
    REPO=/opt/diskort; DAL=main
    COMPOSE=/opt/diskort/infra/docker-compose.yml
    SAGLIK=http://127.0.0.1:3000/healthz
    SEMA=apps/server/src/db.ts ;;
  *) echo "rei-deploy: proje reddedildi: '${proje}' (bilinen: diskort)" >&2; exit 1 ;;
esac

g() { git -C "$REPO" "$@"; }
kisa() { g rev-parse --short "$1"; }
son_gunluk() { ls -t "$LOGDIR/$proje"-*.log 2>/dev/null | head -1 || true; }

durum() {
  g fetch -q origin "$DAL" || echo "UYARI: origin'den çekilemedi, bilgi eski olabilir"
  echo "proje: $proje  dal: $(g branch --show-current)  HEAD: $(kisa HEAD) $(g log -1 --format=%s HEAD)"
  local kirli bekleyen son
  kirli=$(g status --porcelain | wc -l); [ "$kirli" -eq 0 ] || echo "UYARI: çalışma ağacında $kirli değişik dosya"
  bekleyen=$(g rev-list --count "HEAD..origin/$DAL")
  if [ "$bekleyen" -eq 0 ]; then echo "bekleyen commit: yok"; else echo "bekleyen commit: $bekleyen"; g log -n 20 --oneline "HEAD..origin/$DAL"; fi
  if g diff --name-only HEAD "origin/$DAL" -- "$SEMA" | grep -q .; then echo "DİKKAT: şema dosyası değişiyor ($SEMA); deploy'dan önce DB yedeği gerekir, göç geri alınamaz"; fi
  echo "konteyner: $(docker compose -f "$COMPOSE" ps --format '{{.Name}} {{.Status}}' 2>/dev/null | tr '\n' ';')"
  echo "sağlık: $(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$SAGLIK" || echo yok)"
  son=$(son_gunluk); [ -n "$son" ] && echo "son kapı günlüğü: $(basename "$son") (Claude oturumu deploy'u burada görünmez)"
  return 0
}

logla() {
  local son; son=$(son_gunluk)
  [ -n "$son" ] || { echo "günlük yok"; exit 0; }
  echo "== $(basename "$son")"
  echo "NOT: Rei kapısının son deploy'u; Claude oturumu deploy'u buraya yazmaz, güncel durum için deploy-durum"
  tail -n 60 "$son"
}

case "$islem" in
  durum) durum ;;
  log)   logla ;;
  *) echo "kullanım: rei-deploy durum|log <proje>" >&2; exit 1 ;;
esac
