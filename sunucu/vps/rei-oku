#!/usr/bin/env bash
# Ana VPS'te Rei'nin salt okunur Diskort/Tussle sorgu kapısı. root olarak çalışır; `deploy` kullanıcısı yalnız
# /etc/sudoers.d/rei-oku ile ve yalnız rei-kapi üzerinden çağırır. Kaynak: rei projesi sunucu/vps/rei-oku (root:root 755).
# Hiçbir alt komut yazmaz: Diskort feedback-cli'nin set/note, Tussle feedback-cli'nin ack alt komutları burada yoktur.
#
# Kullanım:
#   rei-oku diskort-geri-bildirim list [yeni|incelendi]   son 50 geri bildirim (durum süzgeciyle)
#   rei-oku diskort-geri-bildirim show <id>               tek kaydın ayrıntısı (id: sayı)
#   rei-oku diskort-hata <sinceMs>                        sinceMs (epoch ms) sonrası istemci/sunucu hata özeti, tek satır JSON
#   rei-oku diskort-kullanici-hata <kullanıcı>            client-errors.jsonl'de kullanıcının son 200 satırı (ham JSON, yığın izi dahil)
#   rei-oku tussle-geri-bildirim                          Tussle geri bildirimleri (açık + onaylanmış)
#   rei-oku tussle-hata <N>                               Tussle istemci hata günlüğünün son N satırı (1-1000)
#   rei-oku sunucu-durum                                  güncellik raporu: konteyner Node sürümleri, bekleyen paketler, Docker, yeniden başlatma
# sunucu-durum: /usr/local/lib/rei/sunucu-durum.py (root sahipli); apt ve nodejs.org okumasını nobody ile yapar, yazmaz.
# Diskort: /opt/diskort/infra compose'unun `api` konteyneri (node dist/feedback-cli.js; hata özeti /usr/local/lib/rei/hata-ozet.js
# stdin'den `node -` ile konteynerde koşar, dosya root sahipli). Tussle: `tussle` konteyneri, node scripts/feedback-cli.mjs.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COMPOSE=/opt/diskort/infra/docker-compose.yml
HATA_OZET=/usr/local/lib/rei/hata-ozet.js
DURUM=/usr/local/lib/rei/sunucu-durum.py
SURE=60  # saniye; docker istemcisi için dış sınır
IC_SURE=55 # konteyner içindeki node için iç sınır (istemci ölünce exec işlemi öksüz kalmasın diye içeride de timeout)

[ "$#" -le 3 ] || { echo "rei-oku: fazla argüman" >&2; exit 1; }
alt="${1:-}"; a1="${2:-}"; a2="${3:-}"
ret() { echo "rei-oku: reddedildi: $*" >&2; exit 1; }

diskort() { timeout "$SURE" docker compose -f "$COMPOSE" exec -T api timeout "$IC_SURE" node dist/feedback-cli.js "$@"; }
tussle()  { timeout "$SURE" docker exec tussle timeout "$IC_SURE" node scripts/feedback-cli.mjs "$@"; }

case "$alt" in
  diskort-geri-bildirim)
    case "$a1" in
      list)
        if [ -z "$a2" ]; then diskort list --limit 50
        elif [[ "$a2" =~ ^(yeni|incelendi)$ ]]; then diskort list --status "$a2" --limit 50
        else ret "list süzgeci '$a2' (yeni|incelendi)"; fi ;;
      show)
        [[ "$a2" =~ ^[0-9]{1,9}$ ]] || ret "show id sayı olmalı"
        diskort show "$a2" ;;
      *) ret "diskort-geri-bildirim alt komutu '$a1' (list|show)" ;;
    esac ;;
  diskort-hata)
    [[ "$a1" =~ ^[0-9]{1,13}$ ]] || ret "sinceMs epoch milisaniye olmalı"
    [ -z "$a2" ] || ret "fazla argüman"
    [ -f "$HATA_OZET" ] || { echo "rei-oku: $HATA_OZET yok" >&2; exit 1; }
    timeout "$SURE" docker compose -f "$COMPOSE" exec -T api timeout "$IC_SURE" node - "$a1" < "$HATA_OZET" ;;
  diskort-kullanici-hata)
    [[ "$a1" =~ ^[a-z0-9_.]{3,32}$ ]] || ret "kullanıcı adı"
    [ -z "$a2" ] || ret "fazla argüman"
    # Kayıt `{at, ...body, user}`: user son anahtar; mesaj içindeki tırnak JSON'da kaçışlı, kimliksiz istemci bu deseni taklit edemez. grep çıkış 1 = eşleşme yok, hata değil.
    timeout "$SURE" docker compose -f "$COMPOSE" exec -T api timeout "$IC_SURE" grep -h -F -- "\"user\":\"$a1\"}" /data/client-errors.jsonl | tail -n 200 || [ "${PIPESTATUS[0]}" -eq 1 ] ;;
  tussle-geri-bildirim)
    [ -z "$a1" ] || ret "fazla argüman"
    tussle list --all ;;
  tussle-hata)
    [[ "$a1" =~ ^([1-9][0-9]{0,2}|1000)$ ]] || ret "N 1-1000 arası sayı olmalı"
    [ -z "$a2" ] || ret "fazla argüman"
    tussle errors --tail "$a1" ;;
  sunucu-durum)
    [ -z "$a1$a2" ] || ret "fazla argüman"
    [ -f "$DURUM" ] || { echo "rei-oku: $DURUM yok" >&2; exit 1; }
    timeout "$SURE" /usr/bin/python3 -I "$DURUM" ;;
  *) echo "kullanım: rei-oku diskort-geri-bildirim list [yeni|incelendi] | diskort-geri-bildirim show <id> | diskort-hata <sinceMs> | diskort-kullanici-hata <kullanıcı> | tussle-geri-bildirim | tussle-hata <N> | sunucu-durum" >&2; exit 1 ;;
esac
